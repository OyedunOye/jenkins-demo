pipeline {

agent
    tools {
        maven 'maven-3.9'
    }

    stages {
        stage('build jar') {
            steps {
                script {
                    echo "building the application..."
                    sh "mvn package"
                }
            }
        }

        stage('build image') {
            steps {
                script {
                    echo "building the docker image..."
                    withCredentials([
                        usernamePassword(credentials: 'docker-credentials', usernameVariable: USER, passwordVariable: PWD)
                    ])
                    sh 'docker build -t oluwasade/java-app:jma-3.0 .'
                    sh 'echo $ | docker login -u $USER --password-stdin'
                    sh 'docker push oluwasade/java-app:jma-3.0'
                }
            }
        }

        stage('deploy') {
            steps {
                script {
                    echo "deploying the application..."
                }
            }
        }
    }
}