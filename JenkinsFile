#!/usr/bin/env groovy

// If there is no variable definition below @Library line we have to end this line with _ like illustrated below:
// @Library('jenkins-shared-lib')_
@Library('jenkins-shared-lib')
def gv

pipeline {   
    agent any
    tools {
        maven 'maven-3.9'
    }
    stages {
        stage("init") {
            steps {
                script {
                    gv = load "script.groovy"
                }
            }
        }

        stage("test code") {
            steps {
                script {
                    testSourceCode()
                }
            }
        }

        stage("build jar") {
            steps {
                script {
                    buildJar()
                }
            }
        }

        stage("build and push image") {
            steps {
                script {
                    buildImage()
                }
            }
        }
        
        stage("deploy") {
            steps {
                script {
                    gv.deployApp()
                }
            }
        }               
    }
}
