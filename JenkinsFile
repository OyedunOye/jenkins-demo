#!/usr/bin/env groovy

// Note that this is for global scoped shared library. If there is no variable definition below @Library line we have to end this line with _ like illustrated below:
// @Library('jenkins-shared-lib')_
@Library('jenkins-shared-lib')

// for project scoped shared library the syntax to gain access to functions within this repo will be like below:
// library identifier: 'jenkins-shared-lib@master', retriever: modernSCM(
//         [$class: 'GitSCMSource',
//         remote: 'https://github.com/OyedunOye/jenkins-shared-library.git',
//         credentialsId: 'gitlab-credentials'])
def gv

pipeline {   
    agent any
    tools {
        maven 'maven-3.9'
    }
    stages {
        stage("init") {
            steps {
                script {
                    gv = load "script.groovy"
                }
            }
        }

        stage("test code") {
            steps {
                script {
                    testSourceCode()
                }
            }
        }

        stage("build jar") {
            steps {
                script {
                    buildJar()
                }
            }
        }

        stage("build and push image") {
            steps {
                script {
                    buildImage 'oluwasade/demo-app:jma-4.0'
                    dockerLogin()
                    pushImage 'oluwasade/demo-app:jma-4.0'
                }
            }
        }
        
        stage("deploy") {
            steps {
                script {
                    gv.deployApp()
                }
            }
        }               
    }
}
