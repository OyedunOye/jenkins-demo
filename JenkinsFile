#!/usr/bin/env groovy

// Note that this is for global scoped shared library. If there is no variable definition below @Library line we have to end this line with _ like illustrated below:
// @Library('jenkins-shared-lib')_
@Library('jenkins-shared-lib')

// for project scoped shared library the syntax to gain access to functions within this repo will be like below:
// library identifier: 'jenkins-shared-lib@master', retriever: modernSCM(
//         [$class: 'GitSCMSource',
//         remote: 'https://github.com/OyedunOye/jenkins-shared-library.git',
//         credentialsId: 'gitlab-credentials'])
def gv

pipeline {   
    agent any
    tools {
        maven 'maven-3.9'
    }
    stages {
        stage("init") {
            steps {
                script {
                    gv = load "script.groovy"
                }
            }
        }

        stage("test code") {
            steps {
                script {
                    testSourceCode()
                }
            }
        }

        stage("increment version") {
            steps {
                script {
                    echo 'incrementing app version'
                    sh 'mvn build-helper:parse-version versions:set -DnewVersion=\\${parsedVersion.majorVersion}.\\${parsedVersion.minorVersion}.\\${parsedVersion.nextIncrementalVersion} versions:commit'
                    def matcher = readFile('pom.xml')=~'<version>(.+)</version>'
                    def version = matcher[0][1]
                    env.IMAGE_NAME = "$version-$BUILD_NUMBER"
                }
            }
        }

        stage("build jar") {
            steps {
                script {
                    //    'mvn package' creates new JAR file without checking if there is an existing one or not, leading to many JAR files in the target folder, whereas, 'mvn clean package' first clears any existing JAR file before creating another.
                    sh 'mvn clean package'
                }
            }
        }

        stage("build and push docker image") {

                steps{
                    script{
//                         buildImage 'oluwasade/demo-app:jma-4.0'
//                         dockerLogin()
//                         pushImage 'oluwasade/demo-app:jma-4.0'
                        echo "building the docker image for branch ${BRANCH_NAME}"
                        withCredentials([usernamePassword(credentialsId: 'docker-credentials', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                            sh "docker build -t oluwasade/demo-app:${IMAGE_NAME} ."
                            sh 'echo $PASS | docker login -u $USER --password-stdin'
                            sh "docker push oluwasade/demo-app:${IMAGE_NAME}"
                        }
                    }
                }
        }
        
        stage("deploy") {
            steps {
                script {
                    gv.deployApp()
                }
            }
        }               
    }
}
